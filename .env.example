# ============================================================
#  TraceLearn — Environment Configuration
#  Copy this file to `.env` and fill in what you have.
#
#  IMPORTANT: TraceLearn runs with ZERO keys in DEMO MODE.
#  Every page and endpoint works with seeded demo data.
#  Add the keys below to switch on real ingestion, embeddings and LLM.
# ============================================================

# ---- Flask session ----
SESSION_SECRET_KEY=

# ============================================================
#  SUPABASE  (Postgres + pgvector + Storage)
#  Without DATABASE_URL the app uses a local SQLite file instead.
# ============================================================
# Pooler / direct connection string, e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Project URL + service role key (Storage + REST)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=tracelearn

# ============================================================
#  MODELS
#  Gemini = primary (text + vision + video/audio + embeddings)
#  Groq   = optional fast text fallback
# ============================================================
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=text-embedding-004
EMBED_DIM=768

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================
#  GROUNDING / REFUSAL THRESHOLDS
#  Tuned on eval/test_set.json to maximise refusal F1 with the local
#  provider (unsupported <= 0.28, grounded >= 0.37). Re-tune after
#  switching to real embeddings, since score magnitudes change.
# ============================================================
T_HIGH=0.36
T_LOW=0.28

# ============================================================
#  APP
# ============================================================
# Set to 1 to force demo mode even when keys are present.
DEMO_MODE=
